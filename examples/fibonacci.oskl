// Fibonacci: recursive and iterative versions.

fn fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

for n in 0..=10 {
  print("fib(${n}) = ${fib(n)}");
}

// The iterative version does not suffer from recursion depth.
fn fibFast(n) {
  var a = 0;
  var b = 1;
  for (var i = 0; i < n; i += 1) {
    var next = a + b;
    a = b;
    b = next;
  }
  return a;
}

print("fibFast(50) = ${fibFast(50)}");
