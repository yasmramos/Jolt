// Fibonacci: recursive and iterative versions.

fn fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

for n in 0..=10 {
  print("fib(${n}) = ${fib(n)}");
}

// The iterative version does not suffer from recursion depth.
fn fib_fast(n) {
  let a = 0;
  let b = 1;
  for (let i = 0; i < n; i += 1) {
    let next = a + b;
    a = b;
    b = next;
  }
  return a;
}

print("fib_fast(50) = ${fib_fast(50)}");
