// Closures: functions that remember their environment.

fn make_counter(start) {
  var count = start;
  return {
    next: () => {
      count += 1;
      return count;
    },
    current: () => count,
    reset: () => {
      count = start;
    },
  };
}

var a = make_counter(0);
var b = make_counter(100);

print("a.next() = ${a.next()}");
print("a.next() = ${a.next()}");
print("b.next() = ${b.next()}");
print("a.current() = ${a.current()}");

a.reset();
print("after reset, a.current() = ${a.current()}");
