{
  "name": "oskel",
  "displayName": "Oskel",
  "description": "Syntax highlighting for the Oskel programming language (.oskl).",
  "version": "0.1.0",
  "publisher": "oskel-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasmramos/Oskel.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["oskel", "language", "syntax", "highlighting"],
  "contributes": {
    "languages": [
      {
        "id": "oskel",
        "aliases": ["Oskel", "oskel"],
        "extensions": [".oskl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oskel",
        "scopeName": "source.oskl",
        "path": "./syntaxes/oskel.tmLanguage.json"
      }
    ]
  }
}
