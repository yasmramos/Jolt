// `extern "C" { ... }` blocks (PHASE 6.6, declaration half). A block declares
// C functions with the FFI type vocabulary; each declaration follows the
// `native fn` path, so the name binds to the host function of the same name
// and the signature is checked at the call site. The block emits no bytecode.

extern "C" {
  fn sqrt(x: double): double;
  fn pow(base: double, exponent: double): double;
  fn len(v): size_t;
  fn str(v: any): string;
}

// A declaration is hoisted, so a function may call one that appears later.
fn area(r: double): double {
  return 3.141592653589793 * pow(r, 2.0);
}

assertEq(sqrt(16.0), 4.0);
assertEq(len([1, 2, 3]), 3);
assertEq(str(42), "42");
assertEq(pow(2.0, 10.0), 1024.0);

// The return type feeds inference: `len` yields a `size_t`, which is an int.
fn lengthOf(a: array): size_t {
  return len(a);
}
let n: int = lengthOf([9, 8, 7]);
assertEq(n, 3);

// A C signature can be spelled the way C spells it, using the FFI vocabulary.
assertEq(area(2.0) > 12.5 && area(2.0) < 12.6, true);

// `ptr` defaults to NULL (`nil`) and accepts `nil` even without `?`.
// A `void` return type is allowed and maps to C's `void`.
extern "C" {
  fn seed(v: size_t): void;
}
let handle: ptr = nil;
assertEq(handle, nil);
seed(1);   // size_t argument, void result

print("extern c ok");
