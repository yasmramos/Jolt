// String literals, interpolation and methods.

var name = "Jolt";
assert_eq("Hello, ${name}!", "Hello, Jolt!");
assert_eq("1+2=${1 + 2}", "1+2=3");
assert_eq("len=${"abc".length}", "len=3");
assert_eq("nested ${"inner ${name}"}", "nested inner Jolt");
assert_eq("map ${ {a: 1}.a }", "map 1");
assert_eq("\u00e9", "é");
assert_eq("\x41", "A");
assert_eq("a\tb", "a" + chr(9) + "b");
assert_eq("\$5", "$5");

assert_eq("áé".length, 2);
assert_eq(len("áé"), 2);
assert_eq("áé"[1], "é");
assert_eq("áé"[-1], "é");

assert_eq("Hello".upper(), "HELLO");
assert_eq("Hello".lower(), "hello");
assert_eq("  x  ".trim(), "x");
assert_eq("  x  ".trim_start(), "x  ");
assert_eq("  x  ".trim_end(), "  x");
assert_eq("a,b,c".split(","), ["a", "b", "c"]);
assert_eq("a b  c".split(), ["a", "b", "c"]);
assert_eq("abc".chars(), ["a", "b", "c"]);
assert_eq("a-b".replace("-", "+"), "a+b");
assert_eq("a-a".replace_first("a", "b"), "b-a");
assert_eq("abc".starts_with("ab"), true);
assert_eq("abc".ends_with("bc"), true);
assert_eq("abc".contains("b"), true);
assert_eq("abc".index_of("c"), 2);
assert_eq("abc".index_of("z"), -1);
assert_eq("abcdef".substr(1, 3), "bcd");
assert_eq("abcdef".substr(-2), "ef");
assert_eq("ab".repeat(3), "ababab");
assert_eq("abc".reversed(), "cba");
assert_eq("5".pad_start(3, "0"), "005");
assert_eq("5".pad_end(3, "0"), "500");
assert_eq("a\nb".lines(), ["a", "b"]);
assert_eq("hello" + " " + "world", "hello world");
assert_eq("abc"[1], "b");
assert_eq("abc"[-1], "c");
assert_eq("multi
line", "multi" + chr(10) + "line");

print("strings ok");
