// Java-style `float` (binary32) and `double` (binary64).
//
// A fractional literal with no suffix is a `double`; a trailing `f`/`F` makes
// it a `float`. `int` widens to `float` and to `double`, `float` widens to
// `double`, and an operation produces the widest operand's type.

// The two types are distinct, and `type` names them.
assertEq(type(1.5), "double");
assertEq(type(1.5f), "float");
assertEq(type(1), "int");

// An integer-looking literal with an `f` suffix is a float (like Java).
assertEq(type(1f), "float");
assertEq(type(1e3f), "float");

// int -> float -> double widening is implicit.
let i: int = 3;
let f: float = i;
let d: double = i;
assertEq(f, 3.0);
assertEq(d, 3.0);
let fromFloat: double = f;
assertEq(fromFloat, 3.0);

// A float and a double are numerically equal when they hold the same value.
assertEq(1.5f == 1.5, true);
assertEq(float(1.5) == 1.5, true);

// Promotion: the result is the widest operand's type.
assertEq(type(1.5f + 1.5f), "float");
assertEq(type(1.5f + 1.5), "double");
assertEq(type(1.5 + 1.5), "double");
assertEq(type(1 + 1.5f), "float");
assertEq(type(2 * 3), "int");

// `0.1f` is binary32 of 0.1, which differs from the binary64 value of `0.1`.
assertEq(0.1f == 0.1, false);
// Arithmetic stays in binary32, so `0.1f + 0.2f` rounds to `0.3f` (Java-compatible),
// while the same sum in binary64 does not equal `0.3`.
assertEq(0.1f + 0.2f == 0.3f, true);
assertEq(0.1 + 0.2 == 0.3, false);

// A float literal prints with binary32 precision, so 0.1f reads back as "0.1".
assertEq(str(0.1f), "0.1");
assertEq(str(1.5f), "1.5");
assertEq(str(1.5), "1.5");

// Conversions: `float` narrows to binary32, `double` widens back.
assertEq(type(float(1)), "float");
assertEq(type(double(1.5f)), "double");
assertEq(float(1.5), 1.5f);
assertEq(double(1.5f), 1.5);
assertEq(int(2.9), 2);
assertEq(int(2.9f), 2);

// float() of a string parses and rounds to binary32.
assertEq(float("2.5"), 2.5f);
assertEq(double("2.5"), 2.5);

// floor/ceil/round return `int` for an `int` and `double` for any float type.
assertEq(type(floor(2.7)), "double");
assertEq(type(floor(2)), "int");
assertEq(type(floor(2.7f)), "double");
assertEq(floor(2.7), 2.0);
assertEq(ceil(2.1), 3.0);
assertEq(round(2.5), 3.0);

// Comparisons mix the numeric types.
assertEq(1 < 1.5f, true);
assertEq(1.5f < 1.5, false);
assertEq(2.5f > 2, true);

// A native signature may use `double` (like Java's Math.sqrt).
native fn sqrt(x: double): double;
assertEq(sqrt(9.0), 3.0);
assertEq(sqrt(16), 4.0);

print("float/double ok");
