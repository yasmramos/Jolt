// Arrays, maps and ranges.

let arr = [1, 2, 3];
assert_eq(arr, [1, 2, 3]);
assert_eq(arr.length, 3);
assert_eq(len(arr), 3);
assert_eq(arr[0], 1);
assert_eq(arr[-1], 3);
arr[0] = 10;
assert_eq(arr, [10, 2, 3]);

let built = [];
built.push(1);
built.push(2, 3);
assert_eq(built, [1, 2, 3]);
assert_eq(built.pop(), 3);
assert_eq(built, [1, 2]);
assert_eq(built.shift(), 1);
assert_eq(built, [2]);
built.unshift(0);
assert_eq(built, [0, 2]);
built.insert(1, 1);
assert_eq(built, [0, 1, 2]);
assert_eq(built.remove_at(1), 1);
assert_eq(built, [0, 2]);

let s = [0, 1, 2, 3, 4];
assert_eq(s.slice(1, 3), [1, 2]);
assert_eq(s.slice(3), [3, 4]);
assert_eq(s.slice(-2), [3, 4]);
assert_eq(s.slice(2, 99), [2, 3, 4]);
assert_eq(s.slice(3, 1), []);

assert_eq([1, 2].concat([3, 4]), [1, 2, 3, 4]);
assert_eq(["a", "b"].join("-"), "a-b");
assert_eq([1, 2, 3].join(), "123");

let unsorted = [3, 1, 2];
assert_eq(unsorted.sorted(), [1, 2, 3]);
assert_eq(unsorted, [3, 1, 2]);
unsorted.sort();
assert_eq(unsorted, [1, 2, 3]);
assert_eq([3, 1, 2].sorted(fn(a, b) => a > b), [3, 2, 1]);
assert_eq(["b", "a", "c"].sorted(), ["a", "b", "c"]);

assert_eq([1, 2, 3].reversed(), [3, 2, 1]);
assert_eq([1, 2].contains(2), true);
assert_eq([1, 2].contains(3), false);
assert_eq([1, 2, 1].index_of(1), 0);
assert_eq([1, 2].index_of(9), -1);

assert_eq([1, 2, 3].map(fn(x) => x + 1), [2, 3, 4]);
assert_eq([1, 2, 3, 4].filter(fn(x) => x % 2 == 0), [2, 4]);
assert_eq([1, 2, 3, 4].reduce(fn(acc, x) => acc + x), 10);
assert_eq([1, 2, 3, 4].reduce(fn(acc, x) => acc + x, 100), 110);

let seen = [];
[1, 2].each(fn(x) {
  seen.push(x * 10);
});
assert_eq(seen, [10, 20]);

assert_eq([1, 2, 3].find(fn(x) => x > 1), 2);
assert_eq([1, 2].find(fn(x) => x > 9), nil);
assert_eq([1, 2, 3].any(fn(x) => x == 3), true);
assert_eq([1, 2, 3].any(fn(x) => x > 9), false);
assert_eq([1, 2, 3].all(fn(x) => x > 0), true);
assert_eq([1, 2, 3].all(fn(x) => x > 1), false);
assert_eq([1, 2, 3].sum(), 6);
assert_eq([1, 2.5].sum(), 3.5);

let clone_src = [1, 2];
let clone_dst = clone_src.clone();
clone_dst.push(3);
assert_eq(clone_dst, [1, 2, 3]);
assert_eq(clone_src, [1, 2]);

let clearing = [1, 2];
clearing.clear();
assert_eq(clearing, []);
assert_eq(clearing.length, 0);

// Maps preserve insertion order.
let person = {name: "Ada", age: 36};
assert_eq(person.name, "Ada");
assert_eq(person["age"], 36);
assert_eq(person.length, 2);
assert_eq(len(person), 2);

person.age = 37;
assert_eq(person.age, 37);
person["city"] = "London";
assert_eq(person.city, "London");

assert_eq(person.missing, nil);
assert_eq(person["missing"], nil);
assert_eq(person.has("name"), true);
assert_eq(person.has("missing"), false);
assert_eq(person.get("age"), 37);
assert_eq(person.get("missing"), nil);
assert_eq(person.get("missing", 0), 0);

assert_eq(person.keys(), ["name", "age", "city"]);
assert_eq(person.values(), ["Ada", 37, "London"]);
assert_eq(person.entries(), [["name", "Ada"], ["age", 37], ["city", "London"]]);

assert_eq(person.delete("city"), true);
assert_eq(person.delete("city"), false);
assert_eq(person.has("city"), false);

let base = {a: 1};
let merged = base.merge({b: 2, a: 3});
assert_eq(merged, {a: 3, b: 2});
assert_eq(base, {a: 3, b: 2});

let copy = {x: 1}.clone();
copy.x = 2;
assert_eq(copy, {x: 2});

let empty = {a: 1};
empty.clear();
assert_eq(empty, {});
assert_eq(empty.length, 0);
assert_eq(empty.has("a"), false);

let literal = {"quoted key": 1, plain: 2};
assert_eq(literal["quoted key"], 1);
assert_eq(literal.plain, 2);

// A real "length" key wins over the built-in member.
let with_length = {length: 99, x: 1};
assert_eq(with_length.length, 99);

let map_keys = [];
for key in {b: 1, a: 2} {
  map_keys.push(key);
}
assert_eq(map_keys, ["b", "a"]);

// Ranges.
let r = 1..5;
assert_eq(type(r), "range");
assert_eq(r.length, 4);
assert_eq(len(r), 4);
assert_eq(r.to_array(), [1, 2, 3, 4]);
assert_eq((1..=5).to_array(), [1, 2, 3, 4, 5]);
assert_eq((5..1).to_array(), [5, 4, 3, 2]);
assert_eq((5..=1).to_array(), [5, 4, 3, 2, 1]);
assert_eq(r.contains(1), true);
assert_eq(r.contains(4), true);
assert_eq(r.contains(5), false);
assert_eq(0..0, 0..0);
assert_eq(0..0 == 0..=0, false);
assert_eq(range(3).to_array(), [0, 1, 2]);
assert_eq(range(2, 5).to_array(), [2, 3, 4]);

// Nested structures, deep equality and shared references.
let nested = {list: [1, [2, 3]], inner: {ok: true}};
assert_eq(nested.list[1][0], 2);
assert_eq(nested.inner.ok, true);
assert_eq(nested, {list: [1, [2, 3]], inner: {ok: true}});
assert_eq([1, [2]].contains([2]), true);

let alias = [1];
let same = alias;
same.push(2);
assert_eq(alias, [1, 2]);

print("collections ok");
