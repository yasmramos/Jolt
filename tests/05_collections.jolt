// Arrays, maps and ranges.

var arr = [1, 2, 3];
assertEq(arr, [1, 2, 3]);
assertEq(arr.length, 3);
assertEq(len(arr), 3);
assertEq(arr[0], 1);
assertEq(arr[-1], 3);
arr[0] = 10;
assertEq(arr, [10, 2, 3]);

var built = [];
built.push(1);
built.push(2, 3);
assertEq(built, [1, 2, 3]);
assertEq(built.pop(), 3);
assertEq(built, [1, 2]);
assertEq(built.shift(), 1);
assertEq(built, [2]);
built.unshift(0);
assertEq(built, [0, 2]);
built.insert(1, 1);
assertEq(built, [0, 1, 2]);
assertEq(built.removeAt(1), 1);
assertEq(built, [0, 2]);

var s = [0, 1, 2, 3, 4];
assertEq(s.slice(1, 3), [1, 2]);
assertEq(s.slice(3), [3, 4]);
assertEq(s.slice(-2), [3, 4]);
assertEq(s.slice(2, 99), [2, 3, 4]);
assertEq(s.slice(3, 1), []);

assertEq([1, 2].concat([3, 4]), [1, 2, 3, 4]);
assertEq(["a", "b"].join("-"), "a-b");
assertEq([1, 2, 3].join(), "123");

var unsorted = [3, 1, 2];
assertEq(unsorted.sorted(), [1, 2, 3]);
assertEq(unsorted, [3, 1, 2]);
unsorted.sort();
assertEq(unsorted, [1, 2, 3]);
assertEq([3, 1, 2].sorted((a, b) => a > b), [3, 2, 1]);
assertEq(["b", "a", "c"].sorted(), ["a", "b", "c"]);

assertEq([1, 2, 3].reversed(), [3, 2, 1]);
assertEq([1, 2].contains(2), true);
assertEq([1, 2].contains(3), false);
assertEq([1, 2, 1].indexOf(1), 0);
assertEq([1, 2].indexOf(9), -1);

assertEq([1, 2, 3].map(x => x + 1), [2, 3, 4]);
assertEq([1, 2, 3, 4].filter(x => x % 2 == 0), [2, 4]);
assertEq([1, 2, 3, 4].reduce((acc, x) => acc + x), 10);
assertEq([1, 2, 3, 4].reduce((acc, x) => acc + x, 100), 110);

var seen = [];
[1, 2].each(x => {
  seen.push(x * 10);
});
assertEq(seen, [10, 20]);

assertEq([1, 2, 3].find(x => x > 1), 2);
assertEq([1, 2].find(x => x > 9), nil);
assertEq([1, 2, 3].any(x => x == 3), true);
assertEq([1, 2, 3].any(x => x > 9), false);
assertEq([1, 2, 3].all(x => x > 0), true);
assertEq([1, 2, 3].all(x => x > 1), false);
assertEq([1, 2, 3].sum(), 6);
assertEq([1, 2.5].sum(), 3.5);

var cloneSrc = [1, 2];
var cloneDst = cloneSrc.clone();
cloneDst.push(3);
assertEq(cloneDst, [1, 2, 3]);
assertEq(cloneSrc, [1, 2]);

var clearing = [1, 2];
clearing.clear();
assertEq(clearing, []);
assertEq(clearing.length, 0);

// Maps preserve insertion order.
var person = {name: "Ada", age: 36};
assertEq(person.name, "Ada");
assertEq(person["age"], 36);
assertEq(person.length, 2);
assertEq(len(person), 2);

person.age = 37;
assertEq(person.age, 37);
person["city"] = "London";
assertEq(person.city, "London");

assertEq(person.missing, nil);
assertEq(person["missing"], nil);
assertEq(person.has("name"), true);
assertEq(person.has("missing"), false);
assertEq(person.get("age"), 37);
assertEq(person.get("missing"), nil);
assertEq(person.get("missing", 0), 0);

assertEq(person.keys(), ["name", "age", "city"]);
assertEq(person.values(), ["Ada", 37, "London"]);
assertEq(person.entries(), [["name", "Ada"], ["age", 37], ["city", "London"]]);

assertEq(person.delete("city"), true);
assertEq(person.delete("city"), false);
assertEq(person.has("city"), false);

var base = {a: 1};
var merged = base.merge({b: 2, a: 3});
assertEq(merged, {a: 3, b: 2});
assertEq(base, {a: 3, b: 2});

var copy = {x: 1}.clone();
copy.x = 2;
assertEq(copy, {x: 2});

var empty = {a: 1};
empty.clear();
assertEq(empty, {});
assertEq(empty.length, 0);
assertEq(empty.has("a"), false);

var literal = {"quoted key": 1, plain: 2};
assertEq(literal["quoted key"], 1);
assertEq(literal.plain, 2);

// A real "length" key wins over the built-in member.
var withLength = {length: 99, x: 1};
assertEq(withLength.length, 99);

var mapKeys = [];
for key in {b: 1, a: 2} {
  mapKeys.push(key);
}
assertEq(mapKeys, ["b", "a"]);

// Map keys: scalar literals are canonicalized to strings, and computed
// keys use the [expr] syntax.
fn keyOf(n) { return "k" + str(n); }
var keyed = {1: "one", true: "yes", nil: "nothing", [2 + 2]: "four", [keyOf(2)]: "two"};
assertEq(keyed["1"], "one");
assertEq(keyed["true"], "yes");
assertEq(keyed["nil"], "nothing");
assertEq(keyed["4"], "four");
assertEq(keyed["k2"], "two");

// Range iteration is lazy: huge ranges never materialize an array.
var counted = 0;
for i in 0..1000000000 {
  counted = counted + 1;
  if (i == 2) { break; }
}
assertEq(counted, 3);

var skipped = [];
for j in 5..=1 {
  if (j == 3) { continue; }
  skipped.push(j);
}
assertEq(skipped, [5, 4, 2, 1]);

// Ranges.
var r = 1..5;
assertEq(type(r), "range");
assertEq(r.length, 4);
assertEq(len(r), 4);
assertEq(r.toArray(), [1, 2, 3, 4]);
assertEq((1..=5).toArray(), [1, 2, 3, 4, 5]);
assertEq((5..1).toArray(), [5, 4, 3, 2]);
assertEq((5..=1).toArray(), [5, 4, 3, 2, 1]);
assertEq(r.contains(1), true);
assertEq(r.contains(4), true);
assertEq(r.contains(5), false);
assertEq(0..0, 0..0);
assertEq(0..0 == 0..=0, false);
assertEq(range(3).toArray(), [0, 1, 2]);
assertEq(range(2, 5).toArray(), [2, 3, 4]);

// Nested structures, deep equality and shared references.
var nested = {list: [1, [2, 3]], inner: {ok: true}};
assertEq(nested.list[1][0], 2);
assertEq(nested.inner.ok, true);
assertEq(nested, {list: [1, [2, 3]], inner: {ok: true}});
assertEq([1, [2]].contains([2]), true);

var alias = [1];
var same = alias;
same.push(2);
assertEq(alias, [1, 2]);

print("collections ok");
