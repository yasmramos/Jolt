// Scoping, shadowing, closures and hoisting.

var global = "g";
assert_eq(global, "g");

{
  var local = "l";
  assert_eq(local, "l");
  var global = "shadow";
  assert_eq(global, "shadow");
}
assert_eq(global, "g");

fn reads_global() {
  return global;
}
assert_eq(reads_global(), "g");

fn compute() {
  var hidden = 42;
  return hidden;
}
assert_eq(compute(), 42);

// Nested blocks can read bindings from their parents.
var depth = 0;
{
  var a = 1;
  {
    var b = 2;
    depth = a + b;
  }
}
assert_eq(depth, 3);

// Shadowing creates a new binding instead of mutating the outer one.
var x = 1;
{
  var x = 2;
  {
    var x = 3;
    assert_eq(x, 3);
  }
  assert_eq(x, 2);
  x = 20;
  assert_eq(x, 20);
}
assert_eq(x, 1);

// Assignment walks up to the nearest existing binding.
var value = "outer";
fn update() {
  value = "inner";
}
update();
assert_eq(value, "inner");

// Variables without an initializer start as nil.
var nothing;
assert_eq(nothing, nil);
var later;
later = 5;
assert_eq(later, 5);

// Function declarations are hoisted within their block.
assert_eq(early(), "hoisted");
fn early() {
  return "hoisted";
}

{
  assert_eq(inner(), 1);
  fn inner() {
    return 1;
  }
}

fn outer() {
  return nested();
  fn nested() {
    return 7;
  }
}
assert_eq(outer(), 7);

// Closures capture bindings by reference.
fn make_getter() {
  var state = 1;
  var get = fn() => state;
  state = 2;
  return get;
}
assert_eq(make_getter()(), 2);

fn make_pair() {
  var n = 5;
  return {
    get: fn() => n,
    set: fn(v) { n = v; },
  };
}
var pair = make_pair();
assert_eq(pair.get(), 5);
pair.set(9);
assert_eq(pair.get(), 9);

// Each for-in iteration has its own variable binding.
var fns = [];
for i in 0..3 {
  fns.push(fn() => i);
}
assert_eq(fns[0](), 0);
assert_eq(fns[1](), 1);
assert_eq(fns[2](), 2);

// A block may shadow a function name.
fn named() {
  return "fn";
}
{
  var named = "var";
  assert_eq(named, "var");
}
assert_eq(named(), "fn");

print("scope ok");
