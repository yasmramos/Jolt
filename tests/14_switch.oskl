// PHASE 6.5 §18.2: `switch` on literals and ranges.
//
// A `switch` evaluates its subject once and runs the body of the first case
// whose label matches (equality for a literal, membership for a range). There
// is no fallthrough: at most one case body runs, then control leaves the
// switch. A `default` clause is optional and runs only when nothing matched.

fn classify(n) {
  switch (n) {
    case 0: {
      return "zero";
    }
    case 1: case 2: case 3: {
      return "small";
    }
    case 10..=20: {
      return "teens";
    }
    default: {
      return "big";
    }
  }
}

assertEq(classify(0), "zero");
assertEq(classify(1), "small");
assertEq(classify(3), "small");
assertEq(classify(15), "teens");
assertEq(classify(99), "big");

// Strings and booleans are valid labels.
fn word(s) {
  switch (s) {
    case "a": {
      return 1;
    }
    case "b": {
      return 2;
    }
    default: {
      return 0;
    }
  }
}
assertEq(word("a"), 1);
assertEq(word("b"), 2);
assertEq(word("c"), 0);

// The subject is evaluated exactly once, even with several cases.
var evaluations = 0;
fn subject() {
  evaluations += 1;
  return 2;
}
switch (subject()) {
  case 1: {
    print("unreachable");
  }
  case 2: {
    print("two");
  }
  case 3: {
    print("unreachable");
  }
}
assertEq(evaluations, 1);

// No fallthrough: only the first matching case runs.
var ran = "";
switch (1) {
  case 1: {
    ran += "a";
  }
  case 2: {
    ran += "b";
  }
}
assertEq(ran, "a");

// A switch with no `default` and no match does nothing.
var untouched = 0;
switch (42) {
  case 1: {
    untouched = 1;
  }
}
assertEq(untouched, 0);

// `break` and `continue` inside a switch bind to the enclosing loop.
var seen = "";
var i = 0;
while (i < 5) {
  i += 1;
  switch (i) {
    case 2: {
      continue;
    }
    case 4: {
      break;
    }
    default: {
      seen += "${i}";
    }
  }
  seen += ".";
}
assertEq(seen, "1.3.");

// A signed numeric label is allowed (`case -1:`, `case +2:`).
fn sign(n) {
  switch (n) {
    case -1: { return "neg"; }
    case +2: { return "plus"; }
    default: { return "other"; }
  }
}
assertEq(sign(-1), "neg");
assertEq(sign(2), "plus");
assertEq(sign(0), "other");

// Each case body is its own scope, like any other block.
switch (7) {
  case 7: {
    let local = 10;
    assertEq(local, 10);
  }
}

print("ok");
