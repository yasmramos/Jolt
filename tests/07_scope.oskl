// Scoping, shadowing, closures and hoisting.

var global = "g";
assertEq(global, "g");

{
  var local = "l";
  assertEq(local, "l");
  var global = "shadow";
  assertEq(global, "shadow");
}
assertEq(global, "g");

fn readsGlobal() {
  return global;
}
assertEq(readsGlobal(), "g");

fn compute() {
  var hidden = 42;
  return hidden;
}
assertEq(compute(), 42);

// Nested blocks can read bindings from their parents.
var depth = 0;
{
  var a = 1;
  {
    var b = 2;
    depth = a + b;
  }
}
assertEq(depth, 3);

// Shadowing creates a new binding instead of mutating the outer one.
var x = 1;
{
  var x = 2;
  {
    var x = 3;
    assertEq(x, 3);
  }
  assertEq(x, 2);
  x = 20;
  assertEq(x, 20);
}
assertEq(x, 1);

// Assignment walks up to the nearest existing binding.
var value = "outer";
fn update() {
  value = "inner";
}
update();
assertEq(value, "inner");

// Variables without an initializer start as nil.
var nothing;
assertEq(nothing, nil);
var later;
later = 5;
assertEq(later, 5);

// Function declarations are hoisted within their block.
assertEq(early(), "hoisted");
fn early() {
  return "hoisted";
}

{
  assertEq(inner(), 1);
  fn inner() {
    return 1;
  }
}

fn outer() {
  return nested();
  fn nested() {
    return 7;
  }
}
assertEq(outer(), 7);

// Closures capture bindings by reference.
fn makeGetter() {
  var state = 1;
  var get = () => state;
  state = 2;
  return get;
}
assertEq(makeGetter()(), 2);

fn makePair() {
  var n = 5;
  return {
    get: () => n,
    set: v => { n = v; },
  };
}
var pair = makePair();
assertEq(pair.get(), 5);
pair.set(9);
assertEq(pair.get(), 9);

// Each for-in iteration has its own variable binding.
var fns = [];
for i in 0..3 {
  fns.push(() => i);
}
assertEq(fns[0](), 0);
assertEq(fns[1](), 1);
assertEq(fns[2](), 2);

// A block may shadow a function name.
fn named() {
  return "fn";
}
{
  var named = "var";
  assertEq(named, "var");
}
assertEq(named(), "fn");

print("scope ok");
