// `extern "C" { ... }` blocks (PHASE 6.6). A declaration binds to a real C
// symbol resolved from the host, and a call marshals its arguments and its
// result across the System V AMD64 ABI without `libffi`. The functions below
// are standard C library names, present in libc/libm on POSIX and in the CRT
// on Windows, so the test runs on both.

extern "C" {
  fn strlen(s: cstring): size_t;
  fn strcmp(a: cstring, b: cstring): int;
  fn abs(x: int): int;
  fn sqrt(x: double): double;
  fn pow(base: double, exponent: double): double;
}

// A Oskel string is a valid `const char *` argument (it is NUL-terminated and
// stays alive for the whole call).
assertEq(strlen("hello"), 5);
assertEq(strlen(""), 0);

// A `cstring` handle exposes the address of its bytes.
let s = cstring("hello world");
assertEq(strlen(s), 11);

// An `int` result is read at its declared width, so it is exact and not
// polluted by the undefined upper half of the return register.
assertEq(abs(-7), 7);
assertEq(abs(7), 7);

// A `double` result comes back from an SSE register.
assertEq(sqrt(16.0), 4.0);
assertEq(pow(2.0, 10.0), 1024.0);

// Two pointer arguments in the same call.
assertEq(strcmp("abc", "abc"), 0);
assertEq(strcmp("abc", "abd") < 0, true);

// A declaration is hoisted, so a function may call one that appears later, and
// the declared result type feeds inference (`size_t` is an int).
fn lengthOf(text: cstring): size_t {
  return strlen(text);
}
let n: int = lengthOf("abcd");
assertEq(n, 4);

print("extern c ok");
