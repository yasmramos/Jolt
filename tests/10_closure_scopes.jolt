// A closure created in a nested block must keep the variables of every
// enclosing scope alive after the function that created it has returned.

fn fromIf() {
  let y = 5;
  if (true) {
    return () => y;
  }
}
assertEq(fromIf()(), 5);

fn fromBlock() {
  let y = 5;
  {
    let z = 1;
    return () => y + z;
  }
}
assertEq(fromBlock()(), 6);

fn fromFor() {
  let y = 5;
  for (var i = 0; i < 1; i += 1) {
    return () => y + i;
  }
}
assertEq(fromFor()(), 5);

fn fromWhile() {
  let y = 5;
  while (true) {
    return () => y;
  }
}
assertEq(fromWhile()(), 5);

fn fromForIn() {
  let base = 10;
  for n in 1..3 {
    if (n == 2) {
      return () => base + n;
    }
  }
}
assertEq(fromForIn()(), 12);

// Several levels of nesting, and mutation through the captured variable.
fn counterFromBlock() {
  var count = 0;
  {
    {
      return () => {
        count += 1;
        return count;
      };
    }
  }
}
let next = counterFromBlock();
assertEq(next(), 1);
assertEq(next(), 2);

// Closures made in the same scope share the variable they capture.
fn shared() {
  var value = 1;
  let result = {};
  if (true) {
    result.get = () => value;
    result.set = v => {
      value = v;
    };
  }
  return result;
}
let box = shared();
box.set(42);
assertEq(box.get(), 42);
