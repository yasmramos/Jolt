// Fixture for `oskel build` (tests/build_binary.cmake).
//
// Only constructs the AOT backend lowers are used (functions, recursion,
// arithmetic, `while`, collections and `print`), so the same program runs on
// the development VM (as an ordinary script test) and compiles to a native
// binary. The output is asserted byte for byte by the CMake script.

fn fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

print("fib(10) =", fib(10));

var total = 0;
var i = 0;
while (i < 5) {
  total = total + i;
  i = i + 1;
}
print("total =", total);

var squares = [1, 4, 9];
print("squares =", squares);
print("9 in squares =", 9 in squares);

var ages = {"ada": 36, "alan": 41};
var ageSum = 0;
for name, age in ages {
  ageSum = ageSum + age;
}
print("age sum =", ageSum);

// Hidden helpers (PHASE 6.5 features the AOT backend now lowers): the
// non-null assertion `!!` and the catch operator. Both compile to a call to a
// runtime helper, so they run identically on the VM and in the static binary.
var maybe = 7;
var sure = maybe!!;
print("non-null =", sure);

var fallback = sure catch 0;
print("catch =", fallback);

// String interpolation lowers to the hidden `$str` helper (PHASE 7c.4b).
var ratio = 1.0 / 3.0;
print("ratio = ${ratio}");
print("sure = ${sure}, label = ${"x"}");

// Ranges lower to the hidden `$range` helper (PHASE 7c.4c): printing,
// iteration, `.length`, membership and interpolation.
print("range =", 0..=5);
var count = 0;
for i in 0..4 {
  count = count + i;
}
print("range sum =", count);
print("range length =", (0..=5).length);
print("3 in range =", 3 in 0..5);
print("range text = ${2..=7}");

// `$str` renders a collection with the recursive repr (PHASE 7c.4b.2), so
// interpolation and `print` agree byte for byte.
var pair = [1, "two"];
print("pair = ${pair}");
print("nested = ${[[1, 2], {"k": 3}]}");
print("ages text = ${ages}");

// Slices lower to the hidden `$slice` helper (PHASE 7c.4d): an array by
// element and a string by UTF-8 code point, with omitted, negative and
// step-carrying bounds.
print("slice =", squares[1:]);
print("reverse =", squares[::-1]);
print("even =", [0, 1, 2, 3, 4, 5][::2]);
print("text =", "abcdef"[1:4]);
print("text reverse =", "abcdef"[::-1]);

// The public standard-library builtins (PHASE 7c.5a): `len`, `type`, `str`,
// `repr`, `bool`, `ord`, `chr`, `assert`, `panic` and `isError`. Each is a
// machine-code function seeded into its global slot, so a `CALL` reaches it
// through the ordinary call path and the VM and the binary agree byte for byte.
print("len =", len("hello"), len(squares), len(ages), len(0..=5));
print("type =", type(nil), type(true), type(1), type(1.5), type("x"), type(squares));
print("type2 =", type(ages), type(fib), type(0..1));
print("str =", str(42), str(3.5), str(true), str(nil));
print("repr =", repr("hi"), repr([1, "two"]), repr(7));
print("bool =", bool(0), bool(1), bool(nil), bool(""), bool(squares));
print("ord =", ord("A"), ord("é"), ord("😀"));
print("chr =", chr(65), chr(233), chr(128512));
assert(true);
assert(len(squares) == 3, "squares has three entries");
print("isError =", isError(5), isError("x"));
