// String literals, interpolation and methods.

var name = "Jolt";
assertEq("Hello, ${name}!", "Hello, Jolt!");
assertEq("1+2=${1 + 2}", "1+2=3");
assertEq("len=${"abc".length}", "len=3");
assertEq("nested ${"inner ${name}"}", "nested inner Jolt");
assertEq("map ${ {a: 1}.a }", "map 1");
assertEq("\u00e9", "é");
assertEq("\x41", "A");
assertEq("a\tb", "a" + chr(9) + "b");
assertEq("\$5", "$5");

assertEq("áé".length, 2);
assertEq(len("áé"), 2);
assertEq("áé"[1], "é");
assertEq("áé"[-1], "é");

assertEq("Hello".upper(), "HELLO");
assertEq("Hello".lower(), "hello");
assertEq("  x  ".trim(), "x");
assertEq("  x  ".trimStart(), "x  ");
assertEq("  x  ".trimEnd(), "  x");
assertEq("a,b,c".split(","), ["a", "b", "c"]);
assertEq("a b  c".split(), ["a", "b", "c"]);
assertEq("abc".chars(), ["a", "b", "c"]);
assertEq("a-b".replace("-", "+"), "a+b");
assertEq("a-a".replaceFirst("a", "b"), "b-a");
assertEq("abc".startsWith("ab"), true);
assertEq("abc".endsWith("bc"), true);
assertEq("abc".contains("b"), true);
assertEq("abc".indexOf("c"), 2);
assertEq("abc".indexOf("z"), -1);
assertEq("abcdef".substr(1, 3), "bcd");
assertEq("abcdef".substr(-2), "ef");
assertEq("ab".repeat(3), "ababab");
assertEq("abc".reversed(), "cba");
assertEq("5".padStart(3, "0"), "005");
assertEq("5".padEnd(3, "0"), "500");
assertEq("a\nb".lines(), ["a", "b"]);
assertEq("hello" + " " + "world", "hello world");
assertEq("abc"[1], "b");
assertEq("abc"[-1], "c");
assertEq("multi
line", "multi" + chr(10) + "line");

print("strings ok");
