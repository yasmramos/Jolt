// Brace-less control-flow bodies (PHASE 6.5).
//
// `if`, `else`, `while`, `for` and `for-in` accept a single statement without
// braces. The single statement is wrapped in a block, so its bytecode is the
// same as the brace form, it is a scope of its own (a `let` in it does not
// leak) and a `defer` in it runs when the body exits. The dangling `else`
// binds to the nearest `if`, like C.

// --- `if` / `else` ---------------------------------------------------------

var label = "";
if (1 < 2) label = "yes"; else label = "no";
assertEq(label, "yes");

if (1 > 2) label = "yes"; else label = "no";
assertEq(label, "no");

// A brace-less `if` may be the body of another brace-less `if`.
var a = 5;
var out = "";
if (a > 0) if (a > 10) out = "big"; else out = "small";
assertEq(out, "small");

// The dangling `else` binds to the nearest `if` (C semantics).
var taken = "";
if (true) if (false) taken = "inner-then"; else taken = "inner-else";
assertEq(taken, "inner-else");

// --- `else if` chains without braces ---------------------------------------

fn grade(n) {
  if (n >= 90) return "A";
  else if (n >= 70) return "B";
  else if (n >= 50) return "C";
  else return "F";
}
assertEq(grade(95), "A");
assertEq(grade(75), "B");
assertEq(grade(55), "C");
assertEq(grade(10), "F");

// --- `while` ---------------------------------------------------------------

var i = 0;
while (i < 4) i += 1;
assertEq(i, 4);

// A `while` body may be a brace-less `if` that `break`s.
var j = 0;
while (true) if (j >= 3) break; else j += 1;
assertEq(j, 3);

// --- classic `for` ---------------------------------------------------------

var sum = 0;
for (var k = 0; k < 4; k += 1) sum += k;
assertEq(sum, 0 + 1 + 2 + 3);

// `continue` and `break` work in a brace-less body.
var odds = 0;
for (var m = 0; m < 10; m += 1) if (m % 2 == 0) continue; else odds += m;
assertEq(odds, 1 + 3 + 5 + 7 + 9);

// --- `for ... in` ----------------------------------------------------------

var seen = [];
for item in [1, 2, 3] seen.push(item);
assertEq(seen, [1, 2, 3]);

var total = 0;
for n in 1..4 total += n;   // 1 + 2 + 3
assertEq(total, 6);

// --- the single statement is its own scope --------------------------------

// A `let` declared in a brace-less body does not leak into the enclosing scope.
var captured = 0;
if (true) { let scoped = 42; captured = scoped; }
assertEq(captured, 42);

// The same is true for a brace-less `for` body: the loop variable is scoped to
// the loop and the body's `let` does not survive it.
var last = 0;
for (var p = 0; p < 3; p += 1) { let twice = p * 2; last = twice; }
assertEq(last, 4);

// --- brace-less bodies with `return` ---------------------------------------

fn firstEven(nums) {
  for n in nums if (n % 2 == 0) return n;
  return -1;
}
assertEq(firstEven([1, 3, 4, 5]), 4);
assertEq(firstEven([1, 3, 5]), -1);

// --- mixed brace and brace-less bodies -------------------------------------

var path = "";
if (true) {
  path = "brace";
} else path = "braceless";
assertEq(path, "brace");
