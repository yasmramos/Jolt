// Numbers, literals and conversions.

assert_eq(1 + 2 * 3, 7);
assert_eq((1 + 2) * 3, 9);
assert_eq(2 ** 10, 1024);
assert_eq(-2 ** 2, -4);
assert_eq(2 ** -1, 0.5);
assert_eq(7 / 2, 3);
assert_eq(-7 / 2, -3);
assert_eq(7 / 2.0, 3.5);
assert_eq(7 % 3, 1);
assert_eq(-7 % 3, -1);
assert_eq(5.5 % 2, 1.5);
assert_eq(10 == 10.0, true);

assert_eq(0x10, 16);
assert_eq(0b1010, 10);
assert_eq(0o17, 15);
assert_eq(1_000_000, 1000000);
assert_eq(1.5e3, 1500.0);

assert_eq(type(1), "int");
assert_eq(type(1.5), "float");
assert_eq(type("x"), "string");
assert_eq(type(nil), "nil");
assert_eq(type(true), "bool");
assert_eq(type([]), "array");
assert_eq(type({}), "map");
assert_eq(type(() => {}), "function");
assert_eq(type(0..1), "range");

assert_eq(int("42"), 42);
assert_eq(int("-7"), -7);
assert_eq(int("0x10"), 16);
assert_eq(int(3.9), 3);
assert_eq(int(true), 1);
assert_eq(float("2.5"), 2.5);
assert_eq(float(2), 2.0);
assert_eq(str(42), "42");
assert_eq(str(nil), "nil");
assert_eq(str([1, 2]), "[1, 2]");
assert_eq(repr("hi"), "\"hi\"");

assert_eq(bool(0), true);
assert_eq(bool(nil), false);
assert_eq(bool(false), false);

assert_eq(min(3, 1, 2), 1);
assert_eq(max(3, 1, 2), 3);
assert_eq(clamp(15, 0, 10), 10);
assert_eq(clamp(-5, 0, 10), 0);
assert_eq(abs(-7), 7);
assert_eq(abs(-2.5), 2.5);
assert_eq(floor(3.7), 3.0);
assert_eq(ceil(3.2), 4.0);
assert_eq(round(2.5), 3.0);
assert_eq(sqrt(81), 9.0);
assert_eq(pow(2, 5), 32.0);

assert_eq(len("áé"), 2);
assert_eq(len([1, 2, 3]), 3);
assert_eq(len({a: 1}), 1);
assert_eq(len(0..5), 5);
assert_eq(len(0..=5), 6);
assert_eq(len(5..0), 5);

assert_eq(chr(65), "A");
assert_eq(chr(233), "é");
assert_eq(ord("A"), 65);
assert_eq(ord("é"), 233);

print("basics ok");
