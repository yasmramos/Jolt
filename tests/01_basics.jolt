// Numbers, literals and conversions.

assertEq(1 + 2 * 3, 7);
assertEq((1 + 2) * 3, 9);
assertEq(2 ** 10, 1024);
assertEq(-2 ** 2, -4);
assertEq(2 ** -1, 0.5);
assertEq(7 / 2, 3);
assertEq(-7 / 2, -3);
assertEq(7 / 2.0, 3.5);
assertEq(7 % 3, 1);
assertEq(-7 % 3, -1);
assertEq(5.5 % 2, 1.5);
assertEq(10 == 10.0, true);

assertEq(0x10, 16);
assertEq(0b1010, 10);
assertEq(0o17, 15);
assertEq(1_000_000, 1000000);
assertEq(1.5e3, 1500.0);

assertEq(type(1), "int");
assertEq(type(1.5), "float");
assertEq(type("x"), "string");
assertEq(type(nil), "nil");
assertEq(type(true), "bool");
assertEq(type([]), "array");
assertEq(type({}), "map");
assertEq(type(() => {}), "function");
assertEq(type(0..1), "range");

assertEq(int("42"), 42);
assertEq(int("-7"), -7);
assertEq(int("0x10"), 16);
assertEq(int(3.9), 3);
assertEq(int(true), 1);
assertEq(float("2.5"), 2.5);
assertEq(float(2), 2.0);
assertEq(str(42), "42");
assertEq(str(nil), "nil");
assertEq(str([1, 2]), "[1, 2]");
assertEq(repr("hi"), "\"hi\"");

assertEq(bool(0), true);
assertEq(bool(nil), false);
assertEq(bool(false), false);

assertEq(min(3, 1, 2), 1);
assertEq(max(3, 1, 2), 3);
assertEq(clamp(15, 0, 10), 10);
assertEq(clamp(-5, 0, 10), 0);
assertEq(abs(-7), 7);
assertEq(abs(-2.5), 2.5);
assertEq(floor(3.7), 3.0);
assertEq(ceil(3.2), 4.0);
assertEq(round(2.5), 3.0);
assertEq(sqrt(81), 9.0);
assertEq(pow(2, 5), 32.0);

assertEq(len("áé"), 2);
assertEq(len([1, 2, 3]), 3);
assertEq(len({a: 1}), 1);
assertEq(len(0..5), 5);
assertEq(len(0..=5), 6);
assertEq(len(5..0), 5);

assertEq(chr(65), "A");
assertEq(chr(233), "é");
assertEq(ord("A"), 65);
assertEq(ord("é"), 233);

print("basics ok");
