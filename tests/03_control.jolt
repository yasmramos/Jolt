// Control flow: conditionals, loops and branches.

var result = "";
if (true) {
  result = "a";
}
assertEq(result, "a");

if (false) {
  result = "b";
} else {
  result = "c";
}
assertEq(result, "c");

var grade = 75;
var label = "";
if (grade >= 90) {
  label = "A";
} else if (grade >= 70) {
  label = "B";
} else {
  label = "C";
}
assertEq(label, "B");

assertEq(true ? 1 : 2, 1);
assertEq(false ? 1 : 2, 2);
assertEq(1 == 1 ? "yes" : "no", "yes");

var n = 7;
assertEq(n > 5 ? n > 10 ? "big" : "medium" : "small", "medium");

// Truthiness: only false and nil are falsey.
var truthy = 0;
if (0) { truthy += 1; }
if ("") { truthy += 1; }
if ([]) { truthy += 1; }
if (nil) { truthy += 100; }
if (false) { truthy += 100; }
assertEq(truthy, 3);

var sum = 0;
var i = 1;
while (i <= 10) {
  sum += i;
  i += 1;
}
assertEq(sum, 55);

sum = 0;
for (var j = 0; j < 10; j += 1) {
  if (j % 2 == 0) {
    continue;
  }
  if (j > 7) {
    break;
  }
  sum += j;
}
assertEq(sum, 16);

// An empty C-style for-loop needs an explicit break.
var guard = 0;
for (;;) {
  guard += 1;
  if (guard == 3) {
    break;
  }
}
assertEq(guard, 3);

var evens = 0;
var k = 0;
while (true) {
  k += 1;
  if (k > 10) {
    break;
  }
  if (k % 2 != 0) {
    continue;
  }
  evens += 1;
}
assertEq(evens, 5);
assertEq(k, 11);

var items = [];
for x in [10, 20, 30] {
  items.push(x);
}
assertEq(items, [10, 20, 30]);

var word = "";
for ch in "abc" {
  word += ch.upper();
}
assertEq(word, "ABC");

var keys = [];
for key in {a: 1, b: 2} {
  keys.push(key);
}
assertEq(keys, ["a", "b"]);

var total = 0;
for v in 1..=5 {
  total += v;
}
assertEq(total, 15);

var down = [];
for v in 5..0 {
  down.push(v);
}
assertEq(down, [5, 4, 3, 2, 1]);

// Nested loops and the scope of break/continue.
var pairs = [];
for a in 0..2 {
  for b in 0..2 {
    if (b == 1) {
      continue;
    }
    pairs.push(str(a) + ":" + str(b));
  }
}
assertEq(["0:0", "1:0"], pairs);

var count = 0;
for a in 0..3 {
  for b in 0..3 {
    if (b == 1) {
      break;
    }
    count += 1;
  }
}
assertEq(count, 3);

// Assignment is an expression that yields the assigned value.
var x = 0;
var y = (x = 5);
assertEq(x, 5);
assertEq(y, 5);

var data = [0, 0];
var old = (data[0] = 9);
assertEq(data[0], 9);
assertEq(old, 9);

var rec = {value: 1};
var prev = (rec.value = 7);
assertEq(rec.value, 7);
assertEq(prev, 7);

// Logical operators short-circuit and return one of their operands.
var calls = 0;
fn bump() {
  calls += 1;
  return true;
}
assertEq(false && bump(), false);
assertEq(calls, 0);
assertEq(true || bump(), true);
assertEq(calls, 0);
assertEq(true && bump(), true);
assertEq(calls, 1);
assertEq(false || bump(), true);
assertEq(calls, 2);

assertEq(nil || "fallback", "fallback");
assertEq("value" || "fallback", "value");
assertEq(nil && 1, nil);
assertEq(0 || 5, 0);

print("control ok");
