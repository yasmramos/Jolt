// Functions, recursion, closures and higher-order use.

fn add(a, b) {
  return a + b;
}
assert_eq(add(2, 3), 5);

fn noop() {}
assert_eq(noop(), nil);

fn greet(name) {
  return "Hello, " + name;
}
assert_eq(greet("Jolt"), "Hello, Jolt");

// return exits the function early.
fn sign(n) {
  if (n < 0) {
    return "neg";
  }
  if (n == 0) {
    return "zero";
  }
  return "pos";
}
assert_eq(sign(-5), "neg");
assert_eq(sign(0), "zero");
assert_eq(sign(8), "pos");

// Recursion.
fn fact(n) {
  if (n <= 1) {
    return 1;
  }
  return n * fact(n - 1);
}
assert_eq(fact(0), 1);
assert_eq(fact(5), 120);
assert_eq(fact(10), 3628800);

fn fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}
assert_eq(fib(10), 55);

// Mutual recursion works thanks to hoisting inside a block.
fn is_even(n) {
  if (n == 0) {
    return true;
  }
  return is_odd(n - 1);
}
fn is_odd(n) {
  if (n == 0) {
    return false;
  }
  return is_even(n - 1);
}
assert_eq(is_even(10), true);
assert_eq(is_odd(10), false);

// Functions are first-class values.
var double = x => { return x * 2; };
assert_eq(double(21), 42);

var triple = x => x * 3;
assert_eq(triple(4), 12);

var join = (a, b) => str(a) + "-" + str(b);
assert_eq(join(1, 2), "1-2");

var ops = {
  add: (a, b) => a + b,
  mul: (a, b) => a * b,
};
assert_eq(ops.add(2, 3), 5);
assert_eq(ops["mul"](2, 3), 6);

// A lambda bound to a variable can call itself recursively.
var power = (base, exp) => exp == 0 ? 1 : base * power(base, exp - 1);
assert_eq(power(2, 10), 1024);

// Closures keep the captured environment alive.
fn make_counter() {
  var count = 0;
  return () => {
    count += 1;
    return count;
  };
}
var counter = make_counter();
assert_eq(counter(), 1);
assert_eq(counter(), 2);
assert_eq(counter(), 3);

var other = make_counter();
assert_eq(other(), 1);
assert_eq(counter(), 4);

fn make_adder(n) {
  return x => x + n;
}
var add5 = make_adder(5);
var add10 = make_adder(10);
assert_eq(add5(1), 6);
assert_eq(add10(1), 11);

// Higher-order functions and chaining.
fn apply(f, x) {
  return f(x);
}
assert_eq(apply(x => x * x, 9), 81);

var numbers = [1, 2, 3, 4];
assert_eq(numbers.map(x => x * 2), [2, 4, 6, 8]);
assert_eq(numbers.map(x => x * 2).filter(x => x > 4), [6, 8]);
assert_eq(numbers.reduce((acc, x) => acc + x, 0), 10);

// Parameters shadow outer variables without touching them.
var value = 10;
fn shadow(value) {
  value += 1;
  return value;
}
assert_eq(shadow(1), 2);
assert_eq(value, 10);

// Arrays are passed by reference, but rebinding a parameter stays local.
fn push_one(arr) {
  arr.push(1);
}
var shared = [];
push_one(shared);
assert_eq(shared, [1]);

fn replace(arr) {
  arr = [9];
  return arr;
}
var original = [1];
assert_eq(replace(original), [9]);
assert_eq(original, [1]);

print("functions ok");
