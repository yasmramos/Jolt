// Functions, recursion, closures and higher-order use.

fn add(a, b) {
  return a + b;
}
assertEq(add(2, 3), 5);

fn noop() {}
assertEq(noop(), nil);

fn greet(name) {
  return "Hello, " + name;
}
assertEq(greet("Jolt"), "Hello, Jolt");

// return exits the function early.
fn sign(n) {
  if (n < 0) {
    return "neg";
  }
  if (n == 0) {
    return "zero";
  }
  return "pos";
}
assertEq(sign(-5), "neg");
assertEq(sign(0), "zero");
assertEq(sign(8), "pos");

// Recursion.
fn fact(n) {
  if (n <= 1) {
    return 1;
  }
  return n * fact(n - 1);
}
assertEq(fact(0), 1);
assertEq(fact(5), 120);
assertEq(fact(10), 3628800);

fn fib(n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}
assertEq(fib(10), 55);

// Mutual recursion works thanks to hoisting inside a block.
fn isEven(n) {
  if (n == 0) {
    return true;
  }
  return isOdd(n - 1);
}
fn isOdd(n) {
  if (n == 0) {
    return false;
  }
  return isEven(n - 1);
}
assertEq(isEven(10), true);
assertEq(isOdd(10), false);

// Functions are first-class values.
var double = x => { return x * 2; };
assertEq(double(21), 42);

var triple = x => x * 3;
assertEq(triple(4), 12);

var join = (a, b) => str(a) + "-" + str(b);
assertEq(join(1, 2), "1-2");

var ops = {
  add: (a, b) => a + b,
  mul: (a, b) => a * b,
};
assertEq(ops.add(2, 3), 5);
assertEq(ops["mul"](2, 3), 6);

// A lambda bound to a variable can call itself recursively.
var power = (base, exp) => exp == 0 ? 1 : base * power(base, exp - 1);
assertEq(power(2, 10), 1024);

// Closures keep the captured environment alive.
fn makeCounter() {
  var count = 0;
  return () => {
    count += 1;
    return count;
  };
}
var counter = makeCounter();
assertEq(counter(), 1);
assertEq(counter(), 2);
assertEq(counter(), 3);

var other = makeCounter();
assertEq(other(), 1);
assertEq(counter(), 4);

fn makeAdder(n) {
  return x => x + n;
}
var add5 = makeAdder(5);
var add10 = makeAdder(10);
assertEq(add5(1), 6);
assertEq(add10(1), 11);

// Higher-order functions and chaining.
fn apply(f, x) {
  return f(x);
}
assertEq(apply(x => x * x, 9), 81);

var numbers = [1, 2, 3, 4];
assertEq(numbers.map(x => x * 2), [2, 4, 6, 8]);
assertEq(numbers.map(x => x * 2).filter(x => x > 4), [6, 8]);
assertEq(numbers.reduce((acc, x) => acc + x, 0), 10);

// Parameters shadow outer variables without touching them.
var value = 10;
fn shadow(value) {
  value += 1;
  return value;
}
assertEq(shadow(1), 2);
assertEq(value, 10);

// Arrays are passed by reference, but rebinding a parameter stays local.
fn pushOne(arr) {
  arr.push(1);
}
var shared = [];
pushOne(shared);
assertEq(shared, [1]);

fn replace(arr) {
  arr = [9];
  return arr;
}
var original = [1];
assertEq(replace(original), [9]);
assertEq(original, [1]);

print("functions ok");
